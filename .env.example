# Contact form (Resend) — copy to .env.local and fill in. Do NOT commit secrets.
# Get a key at https://resend.com (free tier works for low volume).
RESEND_API_KEY=

# Verified sender. Until you verify your own domain in Resend, you can omit this
# and the API route falls back to Resend's onboarding sender for testing.
# Format: "Display Name <address@your-verified-domain>"
CONTACT_FROM=
